# Copy to .env and run all commands from the project directory.
REACHY_ROBOT_URL=http://reachy-mini.local:8000
# For NemoHermes to reach this host service, bind a host address reachable from
# OpenShell (or 0.0.0.0 on a trusted demo LAN). Loopback is the safe local default.
REACHY_BIND=127.0.0.1
REACHY_PORT=8787
REACHY_TOKEN_FILE=.secrets/bridge-token
REACHY_DRY_RUN=false
REACHY_TTS=espeak
REACHY_VOICE=en-us+f3
REACHY_SPEECH_RATE=175
REACHY_SPEECH_PITCH=65
REACHY_SPEECH_RANGE=75
# Optional higher quality host-side OpenAI-compatible TTS. Requires PCM WAV output.
# REACHY_TTS=openai
# REACHY_TTS_BASE_URL=http://127.0.0.1:8880/v1
# REACHY_TTS_MODEL=kokoro
# REACHY_TTS_VOICE=af_heart
# REACHY_TTS_KEY_FILE=.secrets/tts-key
